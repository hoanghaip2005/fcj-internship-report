<mxfile host="app.diagrams.net" modified="2026-11-03T10:35:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="cognito-arch" name="Amazon Cognito Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;AMAZON COGNITO: ENTERPRISE AUTHENTICATION &amp; AUTHORIZATION FLOW&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal;color:#666666;'&gt;User Pools (AuthN) + Identity Pools (AuthZ) + API Gateway &amp; Direct AWS Resource Access&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#232F3E;" parent="1" vertex="1">
          <mxGeometry x="200" y="20" width="1000" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g_client" value="&lt;b&gt;Client Tier&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;fontColor=#475569;fontSize=14;dashed=1;dashPattern=5 5;arcSize=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="240" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="g_cup" value="&lt;b&gt;Authentication Tier (Cognito User Pool)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;verticalAlign=top;fontColor=#9A3412;fontSize=14;dashed=1;dashPattern=5 5;arcSize=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="340" y="90" width="480" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="g_cip" value="&lt;b&gt;Authorization Tier (Cognito Identity Pool + STS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C084FC;verticalAlign=top;fontColor=#6B21A8;fontSize=14;dashed=1;dashPattern=5 5;arcSize=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="340" y="460" width="480" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="g_backend" value="&lt;b&gt;Protected Backend Tier (Microservices)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;verticalAlign=top;fontColor=#166534;fontSize=14;dashed=1;dashPattern=5 5;arcSize=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="880" y="90" width="460" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="g_storage" value="&lt;b&gt;Direct AWS Resource Tier (Zero-Backend)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;verticalAlign=top;fontColor=#1E40AF;fontSize=14;dashed=1;dashPattern=5 5;arcSize=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="880" y="460" width="460" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="n_spa" value="&lt;b&gt;Single Page App / Mobile&lt;/b&gt;&lt;br&gt;(React, Vue, iOS, Android)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=2;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" parent="1" vertex="1">
          <mxGeometry x="125" y="160" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_cf" value="&lt;b&gt;CloudFront + AWS WAF&lt;/b&gt;&lt;br&gt;(Edge Shield &amp; Distribution)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudfront;" parent="1" vertex="1">
          <mxGeometry x="125" y="300" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_client_box" value="&lt;b&gt;Client Responsibilities:&lt;/b&gt;&lt;br&gt;• Cognito Amplify SDK&lt;br&gt;• Stores ID, Access, Refresh Tokens&lt;br&gt;• Calls API Gateway (Bearer Token)&lt;br&gt;• Direct S3 Upload via STS Keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;spacingLeft=10;fontSize=11;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="60" y="440" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n_cup" value="&lt;b&gt;Amazon Cognito&lt;br&gt;User Pool&lt;/b&gt;&lt;br&gt;(User Directory &amp; OIDC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cognito;" parent="1" vertex="1">
          <mxGeometry x="390" y="160" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_lambda_trig" value="&lt;b&gt;Lambda Triggers&lt;/b&gt;&lt;br&gt;(Pre-Signup, Post-Auth,&lt;br&gt;Pre-Token Generation)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=1;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.lambda;" parent="1" vertex="1">
          <mxGeometry x="670" y="160" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_jwt_box" value="&lt;b&gt;Emitted OIDC JWT Tokens:&lt;/b&gt;&lt;br&gt;&lt;b&gt;• ID Token:&lt;/b&gt; User profile attributes (sub, email, custom:tenant_id)&lt;br&gt;&lt;b&gt;• Access Token:&lt;/b&gt; Scopes, groups (Used to authorize API calls)&lt;br&gt;&lt;b&gt;• Refresh Token:&lt;/b&gt; Long-lived token to rotate credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;align=left;spacingLeft=10;fontSize=11;fontColor=#7C2D12;" parent="1" vertex="1">
          <mxGeometry x="365" y="290" width="430" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n_cip" value="&lt;b&gt;Cognito Identity Pool&lt;/b&gt;&lt;br&gt;(Federated Identities)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=2;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cognito;" parent="1" vertex="1">
          <mxGeometry x="390" y="520" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_sts" value="&lt;b&gt;AWS STS&lt;/b&gt;&lt;br&gt;(AssumeRoleWithWebIdentity)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.identity_and_access_management;" parent="1" vertex="1">
          <mxGeometry x="670" y="520" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_sts_box" value="&lt;b&gt;Temporary AWS IAM Credentials:&lt;/b&gt;&lt;br&gt;• AccessKeyId, SecretAccessKey, SessionToken (1 - 12h validity)&lt;br&gt;• Mapped to Authenticated IAM Role with Fine-Grained Policy&lt;br&gt;• Dynamically scopes access: &lt;i&gt;users/${cognito:sub}/*&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;align=left;spacingLeft=10;fontSize=11;fontColor=#581C87;" parent="1" vertex="1">
          <mxGeometry x="365" y="650" width="430" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n_apigw" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;(Cognito User Pool Authorizer)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=2;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.api_gateway;" parent="1" vertex="1">
          <mxGeometry x="920" y="160" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_backend_lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;(Business Microservices)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.lambda;" parent="1" vertex="1">
          <mxGeometry x="1090" y="160" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_dynamodb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;(User Profiles &amp; App Data Store)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.dynamodb;" parent="1" vertex="1">
          <mxGeometry x="1230" y="160" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_apigw_box" value="&lt;b&gt;Zero-Code API Authorization:&lt;/b&gt;&lt;br&gt;• API Gateway downloads &amp; caches JWKS from Cognito&lt;br&gt;• Signature verification runs at edge in ~0ms (Zero Lambda Cost)&lt;br&gt;• Injects claims (sub, groups, tenant) directly into Lambda context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;align=left;spacingLeft=10;fontSize=11;fontColor=#14532D;" parent="1" vertex="1">
          <mxGeometry x="905" y="290" width="410" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n_s3" value="&lt;b&gt;Amazon S3 Bucket&lt;/b&gt;&lt;br&gt;(Tenant Isolated Storage)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.s3;" parent="1" vertex="1">
          <mxGeometry x="1050" y="520" width="75" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_s3_box" value="&lt;b&gt;Zero-Backend Direct S3 Operations:&lt;/b&gt;&lt;br&gt;• Client signs AWS SigV4 requests using STS temporary keys&lt;br&gt;• Eliminates compute &amp; bandwidth proxy bottlenecks on Lambda/EC2&lt;br&gt;• Multi-tenant security enforced via IAM variable substitution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;align=left;spacingLeft=10;fontSize=11;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="905" y="650" width="410" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;[1] Sign-in (AuthN)&lt;/b&gt;&lt;br&gt;Username/Password or Social IdP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#EA580C;fontSize=11;" parent="1" edge="1" source="n_spa" target="n_cup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_trig" value="Triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FB923C;strokeWidth=1;dashed=1;fontColor=#C2410C;fontSize=10;" parent="1" edge="1" source="n_cup" target="n_lambda_trig">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;[2] Return JWTs&lt;/b&gt;&lt;br&gt;(ID, Access, Refresh)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#EA580C;fontSize=11;entryX=0.9;entryY=0.7;exitX=0.1;exitY=0.7;" parent="1" edge="1" source="n_cup" target="n_spa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;[3] API Call (Bearer AccessToken)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#16A34A;fontSize=11;entryX=0;entryY=0.5;exitX=0.5;exitY=0;" parent="1" edge="1" source="n_spa" target="n_apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_back1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;" parent="1" edge="1" source="n_apigw" target="n_backend_lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_back2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;" parent="1" edge="1" source="n_backend_lambda" target="n_dynamodb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;[4] Exchange ID Token&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#9333EA;fontSize=11;" parent="1" edge="1" source="n_spa" target="n_cip">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_sts" value="AssumeRole" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A855F7;strokeWidth=1;dashed=1;" parent="1" edge="1" source="n_cip" target="n_sts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;[5] Return STS Credentials&lt;/b&gt;&lt;br&gt;(AccessKey, SecretKey, SessionToken)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#9333EA;fontSize=11;entryX=0.5;entryY=1;exitX=0;exitY=0.7;" parent="1" edge="1" source="n_cip" target="n_spa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="&lt;b&gt;[6] SigV4 Direct S3 Upload / Download&lt;/b&gt;&lt;br&gt;users/${cognito-identity.amazonaws.com:sub}/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#2563EB;fontSize=11;entryX=0;entryY=0.5;exitX=0.5;exitY=1;" parent="1" edge="1" source="n_spa" target="n_s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
